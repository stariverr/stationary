# ==========================================
# Stationary - Environment Configuration
# ==========================================

# ------------------------------------------
# External Database & Redis Connections
# ------------------------------------------
# External PostgreSQL connection string (must have pgvector and pg_trgm extensions enabled)
DB_URL=postgresql://postgres:password@your-external-db-host:5432/stationary
# External Redis connection string
REDIS_URL=redis://your-external-redis-host:6379

# ------------------------------------------
# Backend Server Settings (Hono + Bun)
# ------------------------------------------
SERVER_PORT=9400
# Generate a secure random secret (min 32 chars)
AUTH_SECRET=your-random-32-char-secret-here
BETTER_AUTH_URL=http://localhost:9400
TRUSTED_ORIGINS=http://localhost:4000,http://localhost:9400

# Email Sending (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_EMAIL_SENDER=noreply@yourdomain.com

# ------------------------------------------
# S3 Compatible Object Storage (R2, AWS, MinIO, etc.)
# ------------------------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_REGION=auto
S3_BUCKET=stationary
STORAGE_IS_PUBLIC=false

# Media CDN URL (Points to custom domain or public S3 bucket)
CDN_BASE_URL=http://localhost:9400

# ------------------------------------------
# Frontend Web Settings (Nuxt 4)
# ------------------------------------------
WEB_PORT=4000
# Browser-accessible backend API URL
NUXT_PUBLIC_API_BASE_URL=http://localhost:9400
# Browser-accessible frontend app URL
NUXT_PUBLIC_APP_URL=http://localhost:4000

# ------------------------------------------
# Optional: OAuth Providers (Better Auth)
# ------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ------------------------------------------
# Optional: TikHub & Cloudflare Turnstile
# ------------------------------------------
# TIKHUB_API_BASE_URL=
# TIKHUB_API_KEY=
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
