{
    "name": "@stationary/server",
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "typecheck": "bun run tsc --noEmit",
        "test:jobs": "bun test src/tests/job_system*.test.ts",
        "test:jobs:db": "RUN_JOB_DB_TESTS=1 bun test src/tests/job_system_db.test.ts",
        "test:ai:db": "RUN_AI_DB_TESTS=1 bun test src/tests/ai_embedding_db.test.ts",
        "build": "bun build src/index.ts --outdir ./dist --target bun --external @napi-rs/image",
        "deploy": "bunx wrangler deploy",
        "worker:dev": "bunx wrangler dev",
        "db:migrate": "bunx drizzle-kit generate && bunx drizzle-kit push",
        "backfill:track-formats": "bun run src/scripts/backfill_track_formats.ts",
        "backfill:track-formats:apply": "bun run src/scripts/backfill_track_formats.ts --apply",
        "docker:build": "docker build --platform linux/amd64 -f Dockerfile -t stationary:latest ../..",
        "generate:openapi": "bun run src/scripts/generate_openapi.ts",
        "generate:model-catalog": "bun run src/scripts/generate_model_catalog.ts",
        "audit:media-track": "bun run src/scripts/audit_media_track_integrity.ts",
        "verify:media-track-migration": "bun run src/scripts/verify_media_track_migration.ts"
    },
    "dependencies": {
        "@ai-sdk/google": "^4.0.69",
        "@ai-sdk/openai": "^4.0.66",
        "@aws-sdk/client-s3": "^3.1131.0",
        "@aws-sdk/lib-storage": "^3.1131.0",
        "@aws-sdk/s3-request-presigner": "^3.1131.0",
        "@napi-rs/image": "^1.15.0",
        "ai": "^7.0.99",
        "better-auth": "^1.7.4",
        "better-result": "^3.0.1",
        "drizzle-orm": "^1.0.0-rc.5-ab785fc",
        "hono": "^4.13.7",
        "ky": "^2.1.0",
        "pg": "^8.23.0",
        "redis": "^6.2.1",
        "resend": "^6.28.0",
        "uuid": "^14.0.2",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260911.1",
        "@types/bun": "latest",
        "@types/pg": "latest",
        "@types/uuid": "^11.0.0",
        "@valibot/to-json-schema": "^1.8.0",
        "drizzle-kit": "^1.0.0-rc.5-ab785fc"
    }
}
