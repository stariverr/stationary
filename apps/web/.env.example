## Browser-facing API base URL. Use "/api" when a gateway (dev proxy, Caddy, ingress) serves the backend
## on the same origin, or the backend's full base URL (e.g. "https://api.example.com/api") for direct access.
NUXT_PUBLIC_API_BASE_URL = '/api'
NUXT_PUBLIC_CDN_BASE_URL = 'http://your.cdn.base.url'
NUXT_PUBLIC_APP_URL = 'http://localhost:4000'

# Vite server.allowedHosts goes here
__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=allowed_hosts