# Auth Secret
AUTH_SECRET="your-secret-here"
# Encrypts stored credentials such as AI provider API keys: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=""
# CIDR blocks AI provider URLs must not resolve to (comma-separated, IPv4 and IPv6). Empty allows
# everything; set it when untrusted users can add providers, e.g. to block cloud metadata:
# AI_BLOCKED_CIDRS=169.254.0.0/16,fe80::/10
AI_BLOCKED_CIDRS=
BETTER_AUTH_URL="http://localhost:9400"
TRUSTED_ORIGINS="http://localhost:4000,http://localhost:9400"

S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_BUCKET=""

